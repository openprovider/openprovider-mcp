{
  "name": "openprovider-mcp",
  "version": "1.0.0",
  "description": "Official Model Context Protocol server for the Openprovider API",
  "license": "MIT",
  "type": "module",
  "bin": { "openprovider-mcp": "dist/index.js" },
  "main": "dist/index.js",
  "files": ["dist", "README.md", "SECURITY.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "repository": { "type": "git", "url": "git+https://github.com/openprovider/openprovider-mcp.git" },
  "homepage": "https://github.com/openprovider/openprovider-mcp#readme",
  "bugs": { "url": "https://github.com/openprovider/openprovider-mcp/issues" },
  "keywords": ["mcp", "model-context-protocol", "openprovider", "domains", "dns", "ssl", "registrar"],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.2",
    "opossum": "^5.0.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/opossum": "^8.1.9",
    "typescript": "^5.6.0"
  }
}
