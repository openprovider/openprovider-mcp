# Openprovider account this server acts as.
# Do NOT enable two-factor authentication on a user used for API access —
# Openprovider rejects 2FA logins over the API (error code 10006).
OPENPROVIDER_USERNAME=your-openprovider-username
OPENPROVIDER_PASSWORD=your-openprovider-password

# Optional: override the API base URL (defaults to the production API).
# OPENPROVIDER_BASE_URL=https://api.openprovider.eu/v1beta
