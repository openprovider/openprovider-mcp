# Openprovider Authentication
#
# Option 1: API Key (preferred)
# Generate one in the Openprovider control panel under Profile → API settings.
# When set, the server uses it directly as the Bearer token — no login call is made.
# OPENPROVIDER_API_KEY=your_api_key
#
# Option 2: Username + Password
# Used when no API key is set. The server calls POST /auth/login on startup
# (or on the first tool call) to exchange credentials for a short-lived token.
# OPENPROVIDER_USERNAME=your_username
# OPENPROVIDER_PASSWORD=your_password

# Debug mode (true/false)
DEBUG=false

# API Base URL (optional, defaults to https://api.openprovider.eu/v1beta)
# API_BASE_URL=https://api.openprovider.eu/v1beta
